; Tema tipografico del juego: Courier Prime como fuente por defecto de
; toda la interfaz (Label, Button, LineEdit, OptionButton, CheckBox...),
; que la heredan sin necesidad de tocar nodo por nodo.
;
; El titulo es la excepcion: usa Special Elite via theme_override_fonts
; en MainGame.tscn, porque es una tipografia "golpeada" de maquina de
; escribir preciosa para un rotulo pero incomoda de leer en textos
; largos o en numeros pequeños.
;
; Ver assets/fonts/README.md para licencias y procedencia.
[gd_resource type="Theme" load_steps=2 format=3 uid="uid://bqxvt3n8kmwyf"]

[ext_resource type="FontFile" path="res://assets/fonts/CourierPrime-Regular.ttf" id="1_courier"]

[resource]
default_font = ExtResource("1_courier")
default_font_size = 16
